# Configuração de desenvolvimento da API VCCTeamForge.
# Copiar para backend/.env (ignorado pelo Git) ou indicar outro ficheiro com VCCTF_ENV_FILE.
# As variáveis de ambiente do processo têm prioridade sobre este ficheiro.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000
APP_WORKERS=1
# IPs de proxies confiáveis para X-Forwarded-For (Nginx local)
FORWARDED_ALLOW_IPS=127.0.0.1
# Por omissão: ativo fora de produção
# API_DOCS_ENABLED=true

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=VCCTeamForgeDB
# Obrigatórios em produção; MONGODB_AUTH_SOURCE assume MONGODB_DATABASE por omissão
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20

# Caminho absoluto obrigatório em produção
ATTACHMENTS_PATH=var/attachments

# Diretório com migrations/, indexes/ e seed/ (por omissão <repo>/database)
# DATABASE_DIR=/opt/vccteamforge/database

# Logging: text (desenvolvimento) ou json (produção). Sem LOG_FILE escreve apenas para stderr/journald.
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FILE=/var/log/vccteamforge/api.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Readiness reporta "degraded" abaixo deste espaço livre no disco dos anexos
HEALTH_MIN_FREE_DISK_MB=1024
