# Configuração de produção da API VCCTeamForge.
# Instalar em /etc/VCCTeamForge/api.env com dono root:vccteamforge e modo 0640.
# Contém segredos: nunca guardar a versão preenchida no Git.

APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=5000
APP_WORKERS=2
FORWARDED_ALLOW_IPS=127.0.0.1
API_DOCS_ENABLED=false

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=VCCTeamForgeDB
MONGODB_USERNAME=VCCTeamForge_app
MONGODB_PASSWORD=ALTERAR
MONGODB_AUTH_SOURCE=VCCTeamForgeDB
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20

ATTACHMENTS_PATH=/var/lib/VCCTeamForge/attachments
# Tamanho máximo por anexo (bytes; ≤ 25 MiB do Nginx) e número máximo por issue
ATTACHMENTS_MAX_BYTES=20971520
ATTACHMENTS_MAX_PER_ISSUE=50
DATABASE_DIR=/opt/VCCTeamForge/database

# Backups diários (VCCTeamForge-backup.timer): diretoria e número de arquivos mantidos.
BACKUP_PATH=/var/backups/VCCTeamForge
BACKUP_RETENTION=14

# json para journald/ferramentas de análise; sem LOG_FILE os logs vão para o journald.
LOG_LEVEL=INFO
LOG_FORMAT=json

HEALTH_MIN_FREE_DISK_MB=1024

# Com HTTPS (recomendado) manter COOKIE_SECURE por omissão (true).
# Apenas se o Nginx servir HTTP simples na LAN:
# COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
