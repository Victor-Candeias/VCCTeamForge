# Corre VCCTeamForge-report-snapshots.service todos os dias às 23:50 UTC (o dia do snapshot é
# o dia UTC) e recupera a execução perdida se a máquina estiver desligada à hora marcada.

[Unit]
Description=VCCTeamForge snapshots diários de relatório (timer)

[Timer]
OnCalendar=*-*-* 23:50:00 UTC
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
